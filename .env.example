# --- Server ---
PORT=3000
NODE_ENV=development
# Optional: set this to your public URL in production (e.g. https://requests.yourcompany.com).
# If unset, the app derives it from the incoming request, which is usually fine.
APP_ORIGIN=

# --- Database (Neon Postgres) ---
# From your Neon project: Connection Details -> Connection string (use the "pooled" one).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Any random string, 32+ characters recommended. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (Brevo) ---
# Brevo dashboard -> SMTP & API -> API Keys
BREVO_API_KEY="brevo-api-key"
# Must be an email address/domain verified as a sender in Brevo.
EMAIL_FROM_ADDRESS="email"
EMAIL_FROM_NAME="email-from-name"

# --- Initial admin account (used only by `npm run db:seed`) ---
ADMIN_EMAIL="admin-email"
ADMIN_PASSWORD="admin-password"
ADMIN_NAME="Admin-name"
